<resources>
    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowNoTitle">true</item> <!-- Removes the default title bar -->
        <item name="android:windowActionBar">false</item> <!-- Ensures no default action bar is used -->

        <!-- Status bar color for both light and dark mode -->
        <item name="android:statusBarColor">#000000</item> <!-- Black color for status bar -->
    </style>

    <!-- Custom style for Toolbar -->
    <style name="CustomToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
</resources>